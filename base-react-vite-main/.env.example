# API Base URL (Dùng proxy /api/v1 qua Vite để tránh lỗi CORS và kết nối Live Railway Backend)
VITE_API_URL=/api/v1

# Encryption Key for sensitive token storage
VITE_DES_ENCRYPT_KEY=ghkd324i0230

# ==============================================================================
# FEATURE FLAGS (MẶC ĐỊNH BẬT TẤT CẢ - ĐỂ TẮT CHỨC NĂNG, ĐỔI THÀNH false HOẶC 0)
# ==============================================================================
# 1. Trợ lý ảo AI Concierge Floating Widget
VITE_FEATURE_CINEBOT_AI=true

# 2. Hộ chiếu điện ảnh & Huy hiệu 3D Hologram (/profile/passport)
VITE_FEATURE_PASSPORT=true

# 3. Đặt vé nhóm & Chia tiền tự động (CineParty) trên sơ đồ ghế
VITE_FEATURE_CINEPARTY=true

# 4. Ghép đôi gu xem phim solo (CineMate)
VITE_FEATURE_CINEMATE=true

# 5. Suất chiếu bí ẩn (Mystery Night Showtimes)
VITE_FEATURE_MYSTERY_NIGHT=true

# 6. Các nút đăng nhập mạng xã hội (Google, Facebook, Zalo)
VITE_FEATURE_SOCIAL_LOGIN=true

# 7. Thanh Đặt vé nhanh tại Hero Banner
VITE_FEATURE_QUICK_BOOKING=true

